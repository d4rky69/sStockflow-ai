# StockFlow AI local environment example

# Core API / PostgreSQL
STOCKFLOW_DB_URL=jdbc:postgresql://localhost:5432/stockflow
STOCKFLOW_DB_USERNAME=stockflow_app
STOCKFLOW_DB_PASSWORD=stockflow_dev
STOCKFLOW_DB_POOL_SIZE=10
SERVER_PORT=8080

# Python services
STOCKFLOW_FORECAST_API_URL=http://127.0.0.1:8101
STOCKFLOW_OPTIMISATION_API_URL=http://127.0.0.1:8102
STOCKFLOW_CORE_API_URL=http://127.0.0.1:8080

# Action MCP remains disabled unless deliberately enabled for a controlled demo.
STOCKFLOW_ENABLE_ACTIONS=false

# Fleetbase phase 1: server-only, read-only connectivity.
# Keep disabled until a test/restricted key is configured on the Core API.
FLEETBASE_ENABLED=false
FLEETBASE_API_URL=https://api.fleetbase.io/v1
FLEETBASE_API_KEY=
FLEETBASE_TENANT_ID=TEN-ACME-PHARMA
# Optional but recommended: enables strict credential-to-organization verification.
FLEETBASE_ORGANIZATION_ID=
FLEETBASE_WRITE_OPERATIONS_ENABLED=false
FLEETBASE_WEBHOOK_SECRET=
FLEETBASE_CONNECT_TIMEOUT_SECONDS=5
FLEETBASE_READ_TIMEOUT_SECONDS=15

# Google Maps Platform server credential. Keep this backend key out of the browser.
# Restrict it to Routes API and Weather API when using one shared prototype key;
# the browser key is configured locally from the Vehicle Fleet map-provider toolbar.
GOOGLE_MAPS_BACKEND_API_KEY=
GOOGLE_MAPS_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes
GOOGLE_MAPS_CONNECT_TIMEOUT_SECONDS=5
GOOGLE_MAPS_READ_TIMEOUT_SECONDS=15
GOOGLE_WEATHER_API_KEY=
GOOGLE_WEATHER_API_URL=https://weather.googleapis.com
GOOGLE_WEATHER_CONNECT_TIMEOUT_SECONDS=5
GOOGLE_WEATHER_READ_TIMEOUT_SECONDS=15
